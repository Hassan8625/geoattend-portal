# GeoAttend Cloud Environment Variables
# For Supabase Cloud PostgreSQL (Free tier - no credit card required)
# Example connection string:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=

# App Port (defaults to 3000 locally, Replit automatically manages PORT)
PORT=3000

# JWT Security Secret (optional custom key)
JWT_SECRET=geofence_attendance_super_secret_jwt_key_2025_secure
